[Unit]
Description=hivescope-bunker (NIP-46 signer, starts locked)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/home/ubuntu/proyectos/hivescope-bunker/hivescope-bunker serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.hivescope-bunker
ProtectHome=read-only
MemoryMax=512M

[Install]
WantedBy=multi-user.target
